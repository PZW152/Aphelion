<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Test names describe behaviour in sentences; xUnit idioms trigger these analyzers. -->
    <NoWarn>$(NoWarn);CA1515;CA1707;CA2007;CA1861;CA1062;CA2000;CA1849</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\Aphelion.Core\Aphelion.Core.csproj" />
  </ItemGroup>

</Project>
